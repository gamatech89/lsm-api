APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Landeseiten Maintenance"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS - comma-separated list of allowed frontend origins (no wildcards in production!)
# Local dev example: http://localhost:3000
# Production example: https://app.wartung-ls.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Session cookies - always set to true in production
SESSION_SECURE_COOKIE=false

# Seeder password - REQUIRED before running db:seed
# Set a secure password here before seeding the database
SEED_PASSWORD=

# AI Chat (Claude API)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Backup Storage Configuration
# Options: local, s3, gcs, gdrive
BACKUP_DRIVER=local

# Backup Retention
BACKUP_MAX_COUNT=10
BACKUP_MAX_AGE_DAYS=30

# Automatic (nightly) backups are OFF by default — backups are created only
# on explicit request. Set to true to opt in to scheduled backups.
BACKUP_SCHEDULE_ENABLED=false
#BACKUP_SCHEDULE_FREQUENCY=weekly   # daily | weekly | monthly
#BACKUP_SCHEDULE_TIME=03:00

# S3 Backup Configuration (if BACKUP_DRIVER=s3)
#BACKUP_AWS_ACCESS_KEY_ID=
#BACKUP_AWS_SECRET_ACCESS_KEY=
#BACKUP_AWS_DEFAULT_REGION=eu-central-1
#BACKUP_AWS_BUCKET=lsm-backups

# Google Cloud Storage (if BACKUP_DRIVER=gcs)
#GOOGLE_CLOUD_KEY_ID=
#GOOGLE_CLOUD_SECRET=
#GOOGLE_CLOUD_BUCKET=lsm-backups

# Google Drive (if BACKUP_DRIVER=gdrive)
#GOOGLE_DRIVE_CLIENT_ID=
#GOOGLE_DRIVE_CLIENT_SECRET=
#GOOGLE_DRIVE_REFRESH_TOKEN=
#GOOGLE_DRIVE_FOLDER_ID=
