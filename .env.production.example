# =====================================================
# LSM Platform - Production Environment Configuration
# =====================================================
# Copy this file to .env on your production server and
# fill in ALL values before deployment.
# =====================================================

# Application Settings
APP_NAME="LSM - Landeseiten Maintenance"
APP_ENV=production
APP_KEY=                              # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

# Locale Settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =====================================================
# DATABASE (MySQL for Production)
# =====================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_secure_database_password

# =====================================================
# SESSION & CACHE
# =====================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com      # Include leading dot for subdomains
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# =====================================================
# SECURITY
# =====================================================
BCRYPT_ROUNDS=12

# Password for seeding initial users (REQUIRED before running db:seed)
SEED_PASSWORD=your_secure_admin_password

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Sanctum Stateful Domains (comma-separated)
SANCTUM_STATEFUL_DOMAINS=your-frontend-domain.com,www.your-frontend-domain.com

# =====================================================
# AI INTEGRATION (Optional - for AI Chat feature)
# =====================================================
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =====================================================
# MAIL CONFIGURATION
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================
# LOGGING
# =====================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                       # Use 'error' in production

# =====================================================
# FILESYSTEM
# =====================================================
FILESYSTEM_DISK=local

# =====================================================
# UPTIME MONITORING
# =====================================================
# How often to check sites (in minutes): 1, 2, 3, 5, 10, 15, 30
UPTIME_CHECK_INTERVAL=5

# How many sites to check simultaneously (10-20 recommended)
UPTIME_CONCURRENCY=10

# Request timeout in seconds
UPTIME_TIMEOUT=15

# Enable/disable monitoring entirely
UPTIME_MONITORING_ENABLED=true

# =====================================================
# OPTIONAL SERVICES
# =====================================================
# Redis (if using for cache/session)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# AWS S3 (if using for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# =====================================================
# DEPLOYMENT CHECKLIST
# =====================================================
# Before deploying, ensure you have:
# [ ] Set APP_DEBUG=false
# [ ] Set APP_ENV=production
# [ ] Generated a unique APP_KEY
# [ ] Configured database credentials
# [ ] Set SESSION_SECURE_COOKIE=true
# [ ] Configured CORS_ALLOWED_ORIGINS
# [ ] Set SEED_PASSWORD before running seeders
# [ ] Configured mail settings
# =====================================================
